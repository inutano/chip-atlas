# ChIP-Atlas environment variables (production)
# Copy to /home/ec2-user/chip-atlas/config/chip-atlas.env and edit.

# SQLite database path (relative to app root)
DATABASE_URL=sqlite://database.sqlite

# Comma-separated list of permitted Host header values.
# Include the domain AND the instance's public IP for direct-IP access.
# Suffix-matching: ".chip-atlas.org" matches "chip-atlas.org" and "www.chip-atlas.org".
CHIP_ATLAS_PERMITTED_HOSTS=.chip-atlas.org

# Puma tuning — t4g.medium has 2 vCPUs, 4 GB RAM.
# 2 workers x 5 threads = 10 concurrent requests.
# Each worker uses ~120 MB RSS; total ~350 MB including master + overhead.
WEB_CONCURRENCY=2
MAX_THREADS=5
PORT=9292

# SQLite PRAGMAs (see lib/db.rb).
# NORMAL locking is correct for multi-worker Puma (WAL handles concurrent reads).
# EXCLUSIVE is only for the local Docker dev environment (bind-mount SIGBUS workaround).
# SQLITE_LOCKING_MODE=NORMAL
# SQLITE_MMAP_SIZE=268435456
