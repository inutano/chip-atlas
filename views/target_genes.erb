<%
  @page_title = 'Target Genes'
  @page_description = 'Search for genes bound by given transcription factors.'
  @active_menu = 'target_genes'
%>
<script id="page-data" type="application/json"><%== { genomes: @list_of_genome }.to_json.gsub('</', '<\/') %></script>

<%== erb :_page_header, locals: {
  title: 'ChIP-Atlas: Target Genes',
  lead: 'Search for genes bound by given transcription factors.'
} %>

<div id="genome-tabs"></div>

<div class="row">
  <div class="col-md-3">
    <div class="panel panel-default">
      <div class="panel-heading"><h4 class="panel-title">1. Choose Antigen</h4></div>
      <div class="panel-body">
        <input type="text" id="track-input" class="form-control" placeholder="type to search" autocomplete="off">
        <div id="antigen-list" class="mt-2"></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="panel panel-default">
      <div class="panel-heading"><h4 class="panel-title">2. Choose Distance from TSS</h4></div>
      <div class="panel-body">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="distance" id="distance-1" value="1" checked>
          <label class="form-check-label" for="distance-1">±1k</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="distance" id="distance-5" value="5">
          <label class="form-check-label" for="distance-5">±5k</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="distance" id="distance-10" value="10">
          <label class="form-check-label" for="distance-10">±10k</label>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6 offset-md-3 d-grid gap-2">
    <button type="button" id="view-target-genes" class="btn btn-primary btn-lg btn-block">View Potential Target Genes</button>
    <button type="button" id="download-tsv" class="btn btn-primary btn-lg btn-block">Download (TSV)</button>
  </div>
</div>
