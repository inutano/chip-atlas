<%
  @page_title = nil
  @page_description = 'Browse and analyse the public ChIP-Seq/DNase-Seq/ATAC-Seq/Bisulfite-Seq data on your browser.'
  @active_menu = nil
%>
<%== erb :_page_header, locals: {
  title: 'ChIP-Atlas',
  lead: "A data-mining suite for exploring epigenomic landscapes by fully integrating " \
        "<span id=\"experiment-count\">#{@number_of_experiments}</span> " \
        "ChIP-seq, ATAC-seq and Bisulfite-seq experiments."
} %>

<div class="row align-height">
  <div class="col-md-4">
    <a href="/peak_browser" class="jumbotron-link">
      <div class="jumbotron">
        <div class="col-icon">
          <%== erb :_icon, locals: { name: 'glasses', size: 'lg' } %>
        </div>
        <div class="col-labels">
          <h3>Peak Browser</h3>
          <div class="labels">
            <span class="label label-primary">ChIP</span>
            <span class="label label-primary">ATAC</span>
            <span class="label label-primary">Bisulfite</span>
          </div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/enrichment_analysis" class="jumbotron-link">
      <div class="jumbotron">
        <div class="col-icon">
          <%== erb :_icon, locals: { name: 'hand-holding-heart', size: 'lg' } %>
        </div>
        <div class="col-labels">
          <h3>Enrichment Analysis</h3>
          <div class="labels">
            <span class="label label-primary">ChIP</span>
            <span class="label label-primary">ATAC</span>
            <span class="label label-primary">Bisulfite</span>
          </div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/diff_analysis" class="jumbotron-link">
      <div class="jumbotron">
        <div class="col-icon">
          <%== erb :_icon, locals: { name: 'balance-scale-left', size: 'lg' } %>
        </div>
        <div class="col-labels">
          <h3>Diff Analysis</h3>
          <div class="labels">
            <span class="label label-primary">ChIP</span>
            <span class="label label-primary">ATAC</span>
            <span class="label label-primary">Bisulfite</span>
          </div>
        </div>
      </div>
    </a>
  </div>
</div>

<div class="row align-height">
  <div class="col-md-4">
    <a href="/target_genes" class="jumbotron-link">
      <div class="jumbotron">
        <div class="col-icon">
          <%== erb :_icon, locals: { name: 'bullseye', size: 'lg' } %>
        </div>
        <div class="col-labels">
          <h3>Target Genes</h3>
          <div class="labels">
            <span class="label label-primary">ChIP</span>
          </div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/colo" class="jumbotron-link">
      <div class="jumbotron">
        <div class="col-icon">
          <%== erb :_icon, locals: { name: 'compress-arrows-alt', size: 'lg' } %>
        </div>
        <div class="col-labels">
          <h3>Colocalization</h3>
          <div class="labels">
            <span class="label label-primary">ChIP</span>
          </div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/search" class="jumbotron-link">
      <div class="jumbotron">
        <div class="col-icon">
          <%== erb :_icon, locals: { name: 'search', size: 'lg' } %>
        </div>
        <div class="col-labels">
          <h3>Dataset Search</h3>
          <div class="labels">
            <span class="label label-primary">ChIP</span>
            <span class="label label-primary">ATAC</span>
            <span class="label label-primary">Bisulfite</span>
          </div>
        </div>
      </div>
    </a>
  </div>
</div>

<div id="service-notice" hidden></div>

<div class="row">
  <div class="col-md-10 offset-md-1 markdown-content">
    <%== Kramdown::Document.new(File.read(File.join(settings.views, 'updates.markdown')), input: 'GFM', hard_wrap: false).to_html %>
  </div>
</div>
