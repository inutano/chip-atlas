<%
  @page_title = 'Colocalization Result'
  @page_description = 'Predicted colocalization partners and their peak-intensity concordance.'
  @active_menu = 'colo'
%>
<div class="row mb-3">
  <div class="col-md-12">
    <h1>ChIP-Atlas: Colocalization Result</h1>
    <div id="result-summary" class="text-muted small mb-2"></div>

    <div class="d-flex align-items-center flex-wrap gap-2">
      <a href="#" id="download-tsv" class="btn btn-sm btn-outline-secondary" hidden>
        <%== erb :_icon, locals: { name: 'download' } %> Download TSV
      </a>
      <a href="#" id="download-gml" class="btn btn-sm btn-outline-secondary" hidden>
        <%== erb :_icon, locals: { name: 'download' } %> Download GML
      </a>
    </div>
  </div>
</div>

<div class="row mb-3">
  <div class="col-md-12">
    <div class="small text-muted mb-1"><b>Color legend &mdash; ChIP-seq data</b> (peak-intensity concordance between the query and each reference experiment)</div>
    <div class="tg-legend" role="img" aria-label="Peak intensity concordance color legend: red for high-high agreement, graduating through yellow-green, green, teal and cyan to blue for low-low agreement, gray for no data, black for a self comparison">
      <span class="tg-legend-swatch" style="background-color:#ff0000">H-H</span>
      <span class="tg-legend-swatch" style="background-color:#aaff00">H-M</span>
      <span class="tg-legend-swatch" style="background-color:#00ff38">M-M</span>
      <span class="tg-legend-swatch" style="background-color:#00ffaa">H-L</span>
      <span class="tg-legend-swatch" style="background-color:#00e2ff">M-L</span>
      <span class="tg-legend-swatch" style="background-color:#0071ff">L-L</span>
      <span class="tg-legend-swatch" style="background-color:#808080">N.D.</span>
      <span class="tg-legend-swatch" style="background-color:#000000;color:#fff">Same</span>
    </div>

    <div class="small text-muted mb-1 mt-2"><b>Color legend &mdash; STRING data</b> (STRING's binding score)</div>
    <div class="tg-legend" role="img" aria-label="STRING score color legend from 0 (blue) to 1000 or higher (red), gray for no data">
      <span class="tg-legend-swatch" style="background-color:#808080">N.D.</span>
      <span class="tg-legend-swatch" style="background-color:#0000ff">0</span>
      <span class="tg-legend-swatch" style="background-color:#00ffff">250</span>
      <span class="tg-legend-swatch" style="background-color:#00ff00">500</span>
      <span class="tg-legend-swatch" style="background-color:#ffff00">750</span>
      <span class="tg-legend-swatch" style="background-color:#ff0000">1000+</span>
    </div>
  </div>
</div>

<div id="loading-state" class="text-muted">Loading&hellip;</div>
<div id="error-state" class="alert alert-danger" hidden></div>

<div id="result-wrap" hidden>
  <details id="experiments-toggle" class="mb-2">
    <summary id="experiments-toggle-summary">Show reference-experiment columns</summary>
    <p class="small text-muted mt-1 mb-0">
      Individual reference experiments are summarized by the query antigen's Average column above.
      Expanding adds one column per reference experiment, already loaded with this result &mdash;
      no extra request is made.
    </p>
  </details>

  <div class="table-responsive" id="result-table-wrap">
    <table class="table table-striped table-sm align-middle" id="result-table">
      <thead>
        <tr id="result-thead-row"></tr>
      </thead>
      <tbody id="result-tbody"></tbody>
    </table>
  </div>

  <div id="row-count" class="text-muted small mt-2"></div>
</div>
