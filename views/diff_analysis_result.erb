<%
  @page_title = 'Diff Analysis Result'
  @page_description = 'Job status and downloads for a submitted diff analysis.'
  @active_menu = 'diff_analysis'
%>

<%== erb :_page_header, locals: {
  title: 'ChIP-Atlas: Diff Analysis',
  lead: 'Detect differential peaks or differentially methylated regions.'
} %>

<div class="row">
  <div class="col-md-10 offset-md-1">
    <div id="error-state" class="alert alert-danger" hidden></div>

    <%#
      Same table as the Enrichment Analysis result page (and the same ids, so
      the two can be compared field by field), differing only in the result
      rows: a diff analysis produces one zip archive rather than an HTML table
      plus a TSV. data-result-key names the key wanted out of
      GET /jobs/:id/result — see frontend/components/job-tracker.ts.
    %>
    <div id="job-tracker" class="job-info">
      <p>Result page URL will be available for a week from the time when 'status' is 'finished'.</p>

      <table class="table">
        <tbody>
          <tr><th scope="row">Project title</th><td id="project-title"></td></tr>
          <tr><th scope="row">Request ID</th><td id="request-id"></td></tr>
          <tr><th scope="row">Submitted at</th><td id="submitted-at"></td></tr>
          <tr><th scope="row">Estimated finishing time</th><td id="estimated-finishing-time"></td></tr>
          <tr><th scope="row">Current time</th><td id="current-time"></td></tr>
          <tr><th scope="row">Status</th><td id="status">Requesting</td></tr>
          <tr><th scope="row">Download Result</th><td class="result-cell"><a id="download-result" data-result-key="zip"></a></td></tr>
        </tbody>
      </table>

      <div id="execution-log"></div>

      <hr>

      <p class="text-muted small mb-0">
        As this function uses the NIG supercomputer system, it may take time to start your job when the
        nodes are busy. Please check computation node status
        <a href="https://sc.ddbj.nig.ac.jp/en/operation/job_queue_status/" target="_blank" rel="noopener noreferrer">here</a>
        (epyc.q).
      </p>
    </div>
  </div>
</div>
