<%
  @page_title = 'Enrichment Analysis'
  @page_description = 'Identify common epigenetic features of a given set of genomic loci and genes.'
  @active_menu = 'enrichment_analysis'
%>
<script id="page-data" type="application/json"><%== {
  genomes: @list_of_genome,
  prefill: {
    taxonomy: @taxonomy,
    genes: @genes,
    genesetA: @genesetA,
    genesetB: @genesetB,
  }
}.to_json.gsub('</', '<\/') %></script>

<%== erb :_page_header, locals: {
  title: 'ChIP-Atlas: Enrichment Analysis',
  lead: 'Identify common epigenetic features of a given set of genomic loci and genes.',
  tutorial: {
    pdf: 'https://chip-atlas.dbcls.jp/data/manual/Enrichment_Analysis/Enrichment_Analysis.pdf',
    movie: 'https://youtu.be/JBOB2PX5_-0',
    togotv: 'http://doi.org/10.7875/togotv.2019.005'
  }
} %>


<div id="genome-tabs"></div>

<div class="row">
  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><h4 class="card-title">1. Experiment type</h4></div>
      <div class="card-body"><div id="facet-track-class"></div></div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><h4 class="card-title">2. Cell type Class</h4></div>
      <div class="card-body"><div id="facet-cell-type-class"></div></div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h4 class="card-title">
          3. Threshold for Significance
          <a class="info-btn" href="#" data-info="threshold" role="button" aria-label="About the significance threshold">&#x24D8;</a>
        </h4>
      </div>
      <div class="card-body"><div id="facet-qval"></div></div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><h4 class="card-title">4. Enter dataset A</h4></div>
      <div class="card-body">
        <div class="form-check"><input class="form-check-input" type="radio" name="dataA-type" id="dataA-bed" value="bed" checked><label class="form-check-label" for="dataA-bed">Genomic regions (BED)</label><a class="info-btn" href="#" data-info="genomic-regions" role="button" aria-label="About genomic regions (BED)">&#x24D8;</a></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="dataA-type" id="dataA-genes" value="gene"><label class="form-check-label" for="dataA-genes">Gene list (symbols or IDs)</label><a class="info-btn" href="#" data-info="gene-list" role="button" aria-label="About gene list">&#x24D8;</a></div>
        <div class="form-check mb-2"><input class="form-check-input" type="radio" name="dataA-type" id="dataA-count" value="count"><label class="form-check-label" for="dataA-count">Gene count table (CSV/TSV)</label><a class="info-btn" href="#" data-info="gene-count-table" role="button" aria-label="About gene count table">&#x24D8;</a></div>
        <textarea class="form-control mb-2" id="dataA-text" rows="6" placeholder="Paste content or use the file picker below."></textarea>
        <input type="file" id="dataA-file" class="form-control form-control-sm">
        <div class="mt-2 d-flex justify-content-between align-items-center">
          <label class="text-muted small mb-0" for="dataA-file">Choose local file</label>
          <a class="linkExample" href="#" id="try-example">Try with example</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><h4 class="card-title">5. Enter dataset B</h4></div>
      <div class="card-body">
        <div class="form-check"><input class="form-check-input" type="radio" name="dataB-type" id="dataB-rnd" value="rnd" checked><label class="form-check-label" for="dataB-rnd">Random permutation of dataset A</label><a class="info-btn" href="#" data-info="permutation" role="button" aria-label="About random permutation">&#x24D8;</a></div>
        <div id="permutation-row" class="ms-4 mb-2">
          <span class="form-check form-check-inline"><input class="form-check-input" type="radio" name="dataB-perm" id="perm-1" value="1" checked><label class="form-check-label" for="perm-1">×1</label></span>
          <span class="form-check form-check-inline"><input class="form-check-input" type="radio" name="dataB-perm" id="perm-10" value="10"><label class="form-check-label" for="perm-10">×10</label></span>
          <span class="form-check form-check-inline"><input class="form-check-input" type="radio" name="dataB-perm" id="perm-100" value="100"><label class="form-check-label" for="perm-100">×100</label></span>
        </div>
        <div class="form-check"><input class="form-check-input" type="radio" name="dataB-type" id="dataB-bed" value="bed"><label class="form-check-label" for="dataB-bed">Genomic regions (BED)</label><a class="info-btn" href="#" data-info="dataset-b-bed" role="button" aria-label="About genomic regions (BED) for dataset B">&#x24D8;</a></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="dataB-type" id="dataB-refseq" value="refseq" disabled><label class="form-check-label" for="dataB-refseq">Refseq coding genes (gene-list mode only)</label></div>
        <div class="form-check mb-2"><input class="form-check-input" type="radio" name="dataB-type" id="dataB-userlist" value="userlist" disabled><label class="form-check-label" for="dataB-userlist">Gene list (gene-list mode only)</label></div>
        <textarea class="form-control mb-2" id="dataB-text" rows="6" placeholder="Paste content or use the file picker below." hidden></textarea>
        <input type="file" id="dataB-file" class="form-control form-control-sm" hidden>
        <p id="dataB-note" class="text-muted small mb-0">Random permutation needs no input.</p>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><h4 class="card-title">6. Analysis description</h4></div>
      <div class="card-body">
        <div class="mb-2">
          <label for="title" class="form-label small text-muted">Analysis title</label>
          <a class="info-btn" href="#" data-info="analysis-title" role="button" aria-label="About analysis title">&#x24D8;</a>
          <input type="text" id="title" class="form-control form-control-sm" value="My project">
        </div>
        <div class="mb-2">
          <label for="dataA-title" class="form-label small text-muted">Dataset A title</label>
          <input type="text" id="dataA-title" class="form-control form-control-sm" value="Dataset A">
        </div>
        <div class="mb-3">
          <label for="dataB-title" class="form-label small text-muted">Dataset B title</label>
          <input type="text" id="dataB-title" class="form-control form-control-sm" value="Dataset B">
        </div>
        <div class="mb-3" id="distance-tss-row" hidden>
          <label class="form-label small text-muted mb-1">
            Distance range from TSS
            <a class="info-btn" href="#" data-info="disttss" role="button" aria-label="About distance range from TSS">&#x24D8;</a>
          </label>
          <div class="d-flex align-items-center gap-1 flex-wrap">
            <span>-</span>
            <input type="number" id="distance-up" class="form-control form-control-sm" style="width:6rem" value="5000" min="0">
            <span>bp &le; TSS &le; +</span>
            <input type="number" id="distance-down" class="form-control form-control-sm" style="width:6rem" value="5000" min="0">
            <span>bp</span>
          </div>
        </div>
        <div class="d-grid">
          <button type="button" id="submit-job" class="btn btn-primary btn-lg">Submit</button>
        </div>
        <div id="submit-status" class="text-muted small mt-2" aria-live="polite"></div>
        <p class="estimated-run-time mb-1">
          Estimated run time: <span id="estimated-run-time">&mdash;</span>
        </p>
        <p class="job-info mb-0">
          <a href="https://sc.ddbj.nig.ac.jp/en/guides/software/GridEngine/" target="_blank" rel="noopener noreferrer">node status (epyc.q)</a>
        </p>
      </div>
    </div>
  </div>
</div>
